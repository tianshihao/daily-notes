{
  "name": "daily-notes",
  "displayName": "Daily Notes",
  "icon": "icon.png",
  "description": "Write daily notes using VS Code.",
  "version": "0.0.11",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tianshihao/daily-notes"
  },
  "publisher": "tianshihao",
  "author": {
    "email": "shihao.tian@outlook.com",
    "name": "Shihao Tian"
  },
  "contributors": [
    {
      "name": "Shihao Tian",
      "email": "shihao.tian@outlook.com"
    }
  ],
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "command": "daily-notes.helloWorld",
        "title": "Hello World",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openTodaysDailyNote",
        "title": "Open Today's Daily Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openThisWeeksWeeklyNote",
        "title": "Open This Week's Weekly Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openThisMonthsMonthlyNote",
        "title": "Open This Month's Monthly Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openThisQuartersQuarterlyNote",
        "title": "Open This Quarter's Quarterly Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openThisYearsYearlyNote",
        "title": "Open This Year's Yearly Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.previousDailyNote",
        "title": "Previous Daily Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.nextDailyNote",
        "title": "Next Daily Note",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openSameDayLastYear",
        "title": "Open Same Day Last Year",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.openNoteTemplate",
        "title": "Open Note Template",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.setUpNotebook",
        "title": "Setup Notebook",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.insertTimestamp",
        "title": "Insert Timestamp",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.toggleDocumentStats",
        "title": "Toggle Document Stats Visibility",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.toggleGitStatus",
        "title": "Toggle Git Status Visibility",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.toggleEnableGit",
        "title": "Toggle Enable Git",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.commit",
        "title": "Commit",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.toggleAutoCommit",
        "title": "Toggle Auto Commit",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.resetAutoCommitInterval",
        "title": "Reset Auto Commit Interval",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.sync",
        "title": "Sync",
        "category": "Daily Notes"
      },
      {
        "command": "daily-notes.toggleautoSync",
        "title": "Toggle Auto Sync",
        "category": "Daily Notes"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "daily-notes.toggleEnableGit",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Daily Notes",
      "properties": {
        "dailyNotes.templates": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "day": { "type": "string" },
            "week": { "type": "string" },
            "month": { "type": "string" },
            "quarter": { "type": "string" },
            "year": { "type": "string" }
          },
          "description": "Markdown template paths relative to the notebook folder, one for each note period."
        },
        "dailyNotes.notebookName": {
          "type": "string",
          "default": "",
          "description": "Optional notebook name shown before the visible status bar components."
        },
        "dailyNotes.notebookPath": {
          "type": "string",
          "default": "",
          "description": "The directory where daily notes are stored."
        },
        "dailyNotes.showDocumentStats": {
          "type": "boolean",
          "default": true,
          "description": "Show the word count and detected language for Markdown (.md) files in the notebook folder."
        },
        "dailyNotes.showGitStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show the notebook's Git, automatic commit, and automatic sync settings in the status bar for Markdown notes."
        },
        "dailyNotes.enableGit": {
          "type": "boolean",
          "default": false,
          "description": "Whether to enable git for daily notes."
        },
        "dailyNotes.commitMessage": {
          "type": "string",
          "default": "Auto commited by Daily Notes",
          "description": "The commit message when committing daily notes."
        },
        "dailyNotes.autoCommit": {
          "type": "boolean",
          "default": false,
          "description": "Whether to automatically commit daily notes."
        },
        "dailyNotes.autoCommitInterval": {
          "type": "integer",
          "minimum": 3,
          "maximum": 600,
          "default": 10,
          "description": "The interval in minutes to automatically commit daily notes."
        },
        "dailyNotes.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "Whether to enable sync for daily notes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "cz-emoji-conventional": "^1.0.2",
    "eslint": "^8.57.0",
    "jsonc-parser": "3.3.1",
    "npm-run-all": "^4.1.5",
    "simple-git": "^4.1.0",
    "tinyld": "^1.3.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "esbuild": "^0.21.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji-conventional",
      "types": {
        "feat": {
          "description": "A new feature",
          "title": "Features",
          "emoji": "✨"
        },
        "fix": {
          "description": "A bug fix",
          "title": "Bug Fixes",
          "emoji": "🩹"
        },
        "docs": {
          "description": "Documentation only changes",
          "title": "Documentation",
          "emoji": "📝"
        },
        "style": {
          "description": "Changes that do not affect the meaning of the code (white-space, formatting, missing semi-colons, etc)",
          "title": "Styles",
          "emoji": "💄"
        },
        "refactor": {
          "description": "A code change that neither fixes a bug nor adds a feature",
          "title": "Code Refactoring",
          "emoji": "🎨"
        },
        "perf": {
          "description": "A code change that improves performance",
          "title": "Performance Improvements",
          "emoji": "🚀"
        },
        "test": {
          "description": "Adding missing tests or correcting existing tests",
          "title": "Tests",
          "emoji": "🧪"
        },
        "build": {
          "description": "Changes that affect the build system or external dependencies (example scopes: gulp, broccoli, npm)",
          "title": "Builds",
          "emoji": "🔨"
        },
        "ci": {
          "description": "Changes to our CI configuration files and scripts (example scopes: Travis, Circle, BrowserStack, SauceLabs)",
          "title": "Continuous Integrations",
          "emoji": "📦"
        },
        "chore": {
          "description": "Other changes that don't modify src or test files",
          "title": "Chores",
          "emoji": "🧹"
        },
        "revert": {
          "description": "Reverts a previous commit",
          "title": "Reverts",
          "emoji": "🔙"
        },
        "release": {
          "description": "Create a release commit",
          "title": "Release",
          "emoji": "🎉"
        }
      }
    }
  }
}
